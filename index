  <!-- SCRIPT LOGIC -->
  <script>
    // Lucide Icons Initialization
    lucide.createIcons();

    // Estado da aplicação
    let selectedFiles = [];
    let convertedCount = 0;
    let potassiumCount = 0;
    let deferredPrompt = null;

    // Elementos DOM
    const dropZone = document.getElementById('drop-zone');
    const fileInput = document.getElementById('file-input');
    const filePanel = document.getElementById('file-panel');
    const fileList = document.getElementById('file-list');
    const fileCount = document.getElementById('file-count');
    const pwaBtn = document.getElementById('pwa-install-btn');

    // Eventos de Drag and Drop
    dropZone.addEventListener('click', () => fileInput.click());
    dropZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropZone.classList.add('bg-yellow-100', 'border-amber-500');
    });
    dropZone.addEventListener('dragleave', () => {
      dropZone.classList.remove('bg-yellow-100', 'border-amber-500');
    });
    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('bg-yellow-100', 'border-amber-500');
      if (e.dataTransfer.files.length > 0) {
        handleFiles(e.dataTransfer.files);
      }
    });

    fileInput.addEventListener('change', (e) => {
      if (e.target.files.length > 0) {
        handleFiles(e.target.files);
      }
    });

    // Manipulação de Arquivos Selecionados
    function handleFiles(files) {
      Array.from(files).forEach(file => {
        const fileObj = {
          id: Math.random().toString(36).substr(2, 9),
          file: file,
          name: file.name,
          size: formatBytes(file.size),
          type: detectFileType(file),
          targetFormat: getDefaultTargetFormat(file),
          status: 'idle', // idle, converting, done, error
          progress: 0,
          convertedBlob: null,
          convertedName: ''
        };
        selectedFiles.push(fileObj);
      });
      updateUI();
    }

    function detectFileType(file) {
      const ext = file.name.split('.').pop().toLowerCase();
      if (['jpg', 'jpeg', 'png', 'webp', 'bmp', 'svg'].includes(ext)) return 'image';
      if (['txt', 'json', 'csv', 'md', 'html'].includes(ext)) return 'text';
      if (['pdf'].includes(ext)) return 'pdf';
      if (['mp3', 'wav', 'ogg'].includes(ext)) return 'audio';
      return 'other';
    }

    function getDefaultTargetFormat(file) {
      const type = detectFileType(file);
      const ext = file.name.split('.').pop().toLowerCase();
      if (type === 'image') return ext === 'png' ? 'jpg' : 'png';
      if (type === 'text') return 'pdf';
      if (type === 'pdf') return 'png';
      if (type === 'audio') return 'wav';
      return 'txt';
    }

    function getTargetOptions(type, currentExt) {
      if (type === 'image') {
        return ['png', 'jpg', 'webp', 'pdf'];
      } else if (type === 'text') {
        return ['pdf', 'txt', 'json', 'csv'];
      } else if (type === 'pdf') {
        return ['png', 'jpg', 'txt'];
      } else if (type === 'audio') {
        return ['wav'];
      }
      return ['txt'];
    }

    function updateUI() {
      if (selectedFiles.length === 0) {
        filePanel.classList.add('hidden');
        return;
      }

      filePanel.classList.remove('hidden');
      fileCount.textContent = selectedFiles.length;
      fileList.innerHTML = '';

      selectedFiles.forEach(item => {
        const fileCard = document.createElement('div');
        fileCard.className = "bg-white p-4 rounded-2xl border border-yellow-200 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4";

        const options = getTargetOptions(item.type, item.name.split('.').pop().toLowerCase())
          .map(fmt => `<option value="${fmt}" ${item.targetFormat === fmt ? 'selected' : ''}>.${fmt.toUpperCase()}</option>`)
          .join('');

        let statusHTML = '';
        if (item.status === 'idle') {
          statusHTML = `<span class="text-xs font-bold text-amber-800 bg-amber-100 px-2.5 py-1 rounded-full">Aguardando</span>`;
        } else if (item.status === 'converting') {
          statusHTML = `
            <div class="flex items-center gap-2 text-amber-600 font-bold text-xs">
